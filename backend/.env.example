# Server configuration
PORT=4000
HOST=localhost

# MongoDB Database URL
DB_URL=mongodb://localhost:27017

# Sentiment Analysis Server URL (default Flask port is 5000)
SENTIMENT_SERVER_URL=http://127.0.0.1:8000

# JWT secrets for authentication
SECRET_KEY_OF_JWT=your_user_jwt_secret_here
SECRET_KEY_OF_ADMIN_JWT=your_admin_jwt_secret_here

# SMTP configuration for emails (e.g., using Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SENDER_EMAIL=your_email@gmail.com
SMTP_SENDER_PASSWORD=your_app_password_here

# Razorpay credentials for payment gateway
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
